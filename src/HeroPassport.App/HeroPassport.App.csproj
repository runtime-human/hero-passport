<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HeroPassport.Application/HeroPassport.Application.csproj" />
    <ProjectReference Include="../HeroPassport.Infrastructure/HeroPassport.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../skills/hero-passport/**/*"
             LinkBase="skills/hero-passport"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE"
             Link="LICENSE"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../README.md"
             Link="README.md"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/*.md"
             LinkBase="docs"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/integrations/*.md"
             LinkBase="docs/integrations"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
