@page "/history/{QuestId}"
@inject HeroPassportHistoryService History

<PageTitle>Quest History · Hero Passport</PageTitle>

<main class="shell">
    <header class="hero-header">
        <p class="eyebrow">Hero Passport · Quest History</p>
        <h1>Quest detail</h1>
        <p><a href="/history">Back to history</a> · <a href="/">Dashboard</a></p>
    </header>

    @if (_load is null)
    {
        <section class="panel">
            <p>Loading Quest history…</p>
        </section>
    }
    else if (_load.Status == QuestHistoryPageStatus.SetupRequired)
    {
        <section class="panel">
            <h2>Setup required</h2>
            <p>Initialize Hero Passport before viewing Quest history.</p>
        </section>
    }
    else if (_load.Status == QuestHistoryPageStatus.Invalid)
    {
        <section class="panel">
            <p role="alert">The Quest identifier is invalid.</p>
        </section>
    }
    else if (_load.Status == QuestHistoryPageStatus.NotFound)
    {
        <section class="panel">
            <p role="alert">This Quest is not available in the current project.</p>
        </section>
    }
    else if (_load.Page is { } page)
    {
        <section class="panel">
            <p class="eyebrow">@page.ProjectDisplayName · @page.HeroName</p>
            <h2>@page.Title</h2>
            <p>@page.QuestType · @page.Status</p>
            <p>@page.Goal</p>
            <p>Started @page.StartedAtUtc.ToString("u")</p>
            @if (page.FinishedAtUtc is { } finished)
            {
                <p>Finished @finished.ToString("u")</p>
            }
        </section>

        @if (page.Report is { } report)
        {
            <section class="panel">
                <h2>Finish report</h2>
                <p><strong>@report.Result</strong> · +@report.XpGained XP</p>
                <p>@report.Summary</p>
                <p>Tests mentioned: @(report.TestsMentioned ? "yes" : "no")</p>
                <p>Scope violations: @report.ScopeViolations · User corrections: @report.UserCorrections</p>
                <p>Build: @report.BuildStatus (@report.BuildEvidence)</p>
                <p>Tests: @report.TestsStatus (@report.TestsEvidence)</p>
                <h3>Skills used</h3>
                <ul>
                    @foreach (var skill in report.SkillsUsed)
                    {
                        <li>@skill</li>
                    }
                </ul>
            </section>
        }
        else
        {
            <section class="panel">
                <p>This Quest is still open.</p>
            </section>
        }
    }
</main>

@code {
    [Parameter]
    public string QuestId { get; set; } = string.Empty;

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private LoadQuestHistoryWebResult? _load;

    protected override async Task OnParametersSetAsync()
    {
        _load = await History.LoadDetailAsync(QuestId);
        SetStatus(_load.Status switch
        {
            QuestHistoryPageStatus.Invalid => Microsoft.AspNetCore.Http.StatusCodes.Status400BadRequest,
            QuestHistoryPageStatus.NotFound => Microsoft.AspNetCore.Http.StatusCodes.Status404NotFound,
            _ => Microsoft.AspNetCore.Http.StatusCodes.Status200OK,
        });
    }

    private void SetStatus(int statusCode)
    {
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = statusCode;
        }
    }
}
