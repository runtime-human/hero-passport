@page "/"
@inject HeroPassportDashboardService Dashboard

<PageTitle>Hero Passport</PageTitle>

@if (_model is null)
{
    <main class="shell">
        <p>Loading Hero Passport…</p>
    </main>
}
else
{
    <main class="shell">
        <header class="hero-header">
            <p class="eyebrow">Hero Passport · @_model.ProjectDisplayName</p>
            @if (!_model.SetupCompleted)
            {
                <h1>Setup required</h1>
                <p>Initialize Hero Passport before using progression and Quest history.</p>
            }
            else if (_model.Hero is { } hero)
            {
                <h1>@hero.Name</h1>
                <p class="hero-rank">Level @hero.Level · <code>@hero.RankKey</code></p>
                <div class="stat-grid" aria-label="Hero progression summary">
                    <article><span>Total XP</span><strong>@hero.TotalXp</strong></article>
                    <article><span>Trust</span><strong>@hero.Trust</strong></article>
                    <article><span>Strain</span><strong>@hero.Strain</strong></article>
                    <article><span>Success streak</span><strong>@hero.SuccessStreak</strong></article>
                </div>
            }
        </header>

        @if (_model.SetupCompleted && _model.Project is { } configuredProject && _model.Hero is { } configuredHero)
        {
            <section class="panel">
                <h2>Current project</h2>
                <p><strong>@configuredProject.DisplayName</strong></p>
                <p>@configuredProject.QuestsFinished completed Quests · @configuredProject.TotalXpEarned XP earned</p>
            </section>

            <section class="panel">
                <h2>Open Quest</h2>
                @if (_model.OpenQuests.Count == 0)
                {
                    <p>No open Quest</p>
                }
                else
                {
                    <ul>
                        @foreach (var quest in _model.OpenQuests)
                        {
                            <li><strong>@quest.Title</strong> · @quest.QuestType</li>
                        }
                    </ul>
                }
            </section>

            <section class="panel">
                <h2>Top Skills</h2>
                @if (configuredHero.TopSkills.Count == 0)
                {
                    <p>No Skill progression yet.</p>
                }
                else
                {
                    <ul class="skill-list">
                        @foreach (var skill in configuredHero.TopSkills)
                        {
                            <li><strong>@skill.SkillKey</strong><span>Level @skill.Level · @skill.Xp XP</span></li>
                        }
                    </ul>
                }
            </section>
        }
    </main>
}

@code {
    private HeroPassportDashboardViewModel? _model;

    protected override async Task OnInitializedAsync()
    {
        _model = await Dashboard.LoadAsync();
    }
}
